# Supabase → Project Settings → API
# URL du projet
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (anon / publishable). Elle est protégée par les politiques RLS.
# Ne mettez JAMAIS la clé service_role / secret ici ni dans le code client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique


# 1 = mode démo (données fictives, aucune connexion à Supabase)
NEXT_PUBLIC_DEMO=0
