# Supabase → Project Settings → API
# URL du projet
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (anon / publishable). Elle est protégée par les politiques RLS.
# Ne mettez JAMAIS la clé service_role / secret ici ni dans le code client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Connexion « G / E » : e-mail Supabase associé à chaque bouton de l'écran de connexion.
# Créez les deux utilisateurs dans Supabase → Authentication → Users avec un mot de passe à 6 chiffres.
NEXT_PUBLIC_EMAIL_GUILLAUME=guillaume@example.com
NEXT_PUBLIC_EMAIL_EMMA=emma@example.com

# 1 = mode démo (données fictives, aucune connexion à Supabase)
NEXT_PUBLIC_DEMO=0
